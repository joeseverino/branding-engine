{
  "name": "branding-engine",
  "version": "0.8.1",
  "description": "Generate favicons, marks, wordmarks, social cards, brand sheets, and web tokens from one color and a 1-3 character glyph.",
  "type": "module",
  "scripts": {
    "check": "npm test && npm run check:package",
    "check:package": "npm pack --dry-run",
    "test": "node --test",
    "test:core": "node --test test/smoke.test.mjs"
  },
  "bin": {
    "branding-engine": "bin/cli.mjs"
  },
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "examples",
    "index.mjs",
    "!examples/figures/*.png"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/branding-engine.git"
  },
  "bugs": {
    "url": "https://github.com/joeseverino/branding-engine/issues"
  },
  "homepage": "https://github.com/joeseverino/branding-engine#readme",
  "keywords": [
    "branding",
    "favicon",
    "brand-kit",
    "logo",
    "monogram",
    "svg",
    "social-cards"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "wawoff2": "^2.0.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "license": "MIT"
}
