{
  "name": "branding-engine",
  "version": "0.8.1",
  "description": "Generate favicons, marks, wordmarks, social cards, brand sheets, and web tokens from one color and a 1-3 character glyph.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json && node scripts/rewrite-declarations.ts",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:core": "node --test test/smoke.test.ts test/regressions.test.ts test/cli.test.ts",
    "check": "npm run typecheck && npm run build && npm test && npm run check:package",
    "check:package": "npm pack --dry-run"
  },
  "bin": {
    "branding-engine": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "assets",
    "examples",
    "!examples/figures/*.png"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/branding-engine.git"
  },
  "bugs": {
    "url": "https://github.com/joeseverino/branding-engine/issues"
  },
  "homepage": "https://github.com/joeseverino/branding-engine#readme",
  "keywords": [
    "branding",
    "favicon",
    "brand-kit",
    "logo",
    "monogram",
    "svg",
    "social-cards"
  ],
  "dependencies": {
    "elkjs": "^0.12.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "wawoff2": "^2.0.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
